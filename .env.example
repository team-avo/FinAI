# ============================================================
# FinAI — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to git.
# ============================================================

# --- App --------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Better Auth (W3) -------------------------------------
# Generate a strong secret: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Database — Neon Postgres (W3) -----------------------
DATABASE_URL=

# --- Email — Resend (W3) ----------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@finai.advertout.in

# --- AI — Google Gemini (aistudio.google.com → Get API key) ---
GOOGLE_GENERATIVE_AI_API_KEY=

# --- WhatsApp Business Cloud API (W14) -------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- File Storage — Cloudflare R2 (W4) -------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=finai-uploads
NEXT_PUBLIC_R2_PUBLIC_URL=

# --- Queue — Upstash QStash (W13) ------------------------
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Cache — Upstash Redis (W3) --------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Observability (W1 optional) -------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
